// ~/.config/waybar/config.jsonc
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "custom/kernel",
        "pulseaudio",
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "dynamic-len": 40,
        "player-icons": {
            "default": "▶"
        },
        "status-icons": {
            "paused": "⏸"
        }
    },

    "custom/kernel": {
        "exec": "uname -r",
        "interval": "once",
        "format": "{}",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL MUTE",
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    }
}
